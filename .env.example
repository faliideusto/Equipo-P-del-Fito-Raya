# Server-only SNP credentials. Set these in your hosting secret manager.
SNP_EMAIL=
SNP_PASSWORD=
# Password for the club position editor, never a NEXT_PUBLIC variable.
POSITIONS_ADMIN_PASSWORD=
# Private persistent storage for club positions, separate from the SNP cache.
PLAYER_POSITIONS_FILE=.club-private/positions.json
# Optional locally; required for persistent positions on Render Free.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SNP_CACHE_SECONDS=60
# On a server, point this to a persistent private volume.
SNP_CACHE_DIR=.snp-cache
# Optional fallback for a manually obtained SNP session. Google is not required.
SNP_SESSION_FILE=.snp-private/session.json
# Wallet (server-only). PEM files and the service account JSON go base64-encoded on one line.
# Fixed public https URL: Apple stores it inside every pass.
PUBLIC_BASE_URL=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON=
